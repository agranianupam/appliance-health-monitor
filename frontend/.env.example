# HiveMQ Cloud or Public Broker WebSocket Configuration
# For HiveMQ Cloud: port 8884 with wss:// (WebSockets over TLS)
# For Public broker: broker.hivemq.com port 8000 with ws:// or 8884 with wss://
VITE_MQTT_BROKER=broker.hivemq.com
VITE_MQTT_PORT=8884
VITE_MQTT_PROTOCOL=wss
VITE_MQTT_TOPIC_PREFIX=appliance

# Separate Dashboard Credentials (keep distinct from ESP32 login)
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

# Optional: Express Backend URL for historical readings across page reloads
VITE_BACKEND_URL=http://localhost:5000
